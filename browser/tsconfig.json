{
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "dom.iterable"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "target": "ES2022",
  }
}

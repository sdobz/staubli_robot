{
  "include": ["js"],
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",

    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["solid-js"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "baseUrl": ".",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}

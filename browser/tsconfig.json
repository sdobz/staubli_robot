{
    "include": ["**/*.d.ts", "**/*.js"],
    "exclude": ["staubli/html/js/vendor"],
    "compilerOptions": {
        "lib": ["ES2023", "DOM", "dom.iterable"],
        "allowImportingTsExtensions": true,
        "moduleResolution": "bundler",
        "noEmit": true,
        "checkJs": true,
        "baseUrl": ".",
        "target": "es2022",
        "outDir": "dist",
        "paths": {
            "linear-solve": ["./js/vendor/gauss-jordan.js"]
        }
    }
}
